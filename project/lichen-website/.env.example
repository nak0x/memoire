# --- Administration (/results) -------------------------------------------
# Obligatoires. Sans elles, /results et /api/admin/* répondent 503.
ADMIN_LOGIN=changeme
ADMIN_PASS=changeme-long-et-aleatoire

# --- Stockage -------------------------------------------------------------
# Doit pointer dans un volume persistant (Coolify : monter /app/data).
DB_PATH=/app/data/questionnaire.db

# Durée de conservation, en mois. Purge quotidienne + au démarrage.
RETENTION_MONTHS=6

# --- Contenu des pages légales (surcharge à l'exécution) ------------------
NUXT_PUBLIC_CONTACT_EMAIL=pro.theolesage@gmail.com
NUXT_PUBLIC_SITE_URL=https://questionnaire.example.eu
NUXT_PUBLIC_HOST_NAME=Hetzner Online GmbH
NUXT_PUBLIC_HOST_LOCATION=Falkenstein, Allemagne (Union européenne)
